  "capabilities": [
    {
      "capability": "metadata.match",
      "reason": "Recognise Codex CLI from its executable name and its published package"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Show the thread, the running turn and the controls for it"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read turn and item events from the App Server the session is already bound to"
    },
    {
      "capability": "upstream.action",
      "reason": "Ask Codex to stop the turn it is running when you press Stop"
    }
  ],
  "actions": [
    {
      "id": "turn.cancel",
      "label": "Stop the turn",
      "effect": "upstream.cancel",
      "implementation": {
        "type": "upstream_cancel"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Cancel the turn the bound App Server is running, which ends it as interrupted",
      "confirmation_required": false
    },
    {
      "id": "thread.refresh",
      "label": "Refresh",
      "effect": "observe",
      "implementation": {
        "type": "presentation"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Draw this package's document again from the thread state the host already holds",
      "confirmation_required": false
    }
