  "capabilities": [
    {
      "capability": "metadata.match",
      "reason": "Recognise Claude Code from its executable name and its published package"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Show what the session is doing and the tool call it is waiting on"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read the lifecycle and tool observations the session already produces"
    },
    {
      "capability": "upstream.action",
      "reason": "Deliver a message you wrote into the session, on its own path and never as an approval"
    },
    {
      "capability": "approval.respond",
      "reason": "Answer the exact tool call Claude Code is waiting on, with the decision you chose"
    },
    {
      "capability": "native_bridge.install",
      "reason": "Register the forwarder Claude Code starts for its channel and its lifecycle and tool hooks"
    }
  ],
  "actions": [
    {
      "id": "prompt.send",
      "label": "Send",
      "effect": "upstream.prompt",
      "implementation": {
        "type": "upstream_method",
        "method": "channel.event",
        "bindings": [
          {
            "parameter": "text",
            "field": {
              "segments": [
                {
                  "type": "member",
                  "name": "params"
                },
                {
                  "type": "member",
                  "name": "content"
                }
              ]
            }
          }
        ]
      },
      "parameters": {
        "parameters": [
          {
            "name": "text",
            "kind": {
              "type": "text",
              "max_length": 8000,
              "multiline": true
            },
            "label": "Message",
            "required": true
          }
        ]
      },
      "description": "Deliver a message into the session, which Claude reads on its next turn",
      "confirmation_required": false
    },
    {
      "id": "approval.respond",
      "label": "Answer the tool call",
      "effect": "approval.respond",
      "implementation": {
        "type": "upstream_method",
        "method": "channel.permission",
        "bindings": [
          {
            "parameter": "decision",
            "field": {
              "segments": [
                {
                  "type": "member",
                  "name": "params"
                },
                {
                  "type": "member",
                  "name": "behavior"
                }
              ]
            }
          }
        ]
      },
      "parameters": {
        "parameters": [
          {
            "name": "decision",
            "kind": {
              "type": "choice",
              "choices": [
                {
                  "id": "allow",
                  "label": "Allow"
                },
                {
                  "id": "deny",
                  "label": "Deny"
                }
              ]
            },
            "label": "Decision",
            "required": true
          }
        ]
      },
      "description": "Answer the pending tool call with allow or deny; the broker names the request",
      "confirmation_required": false
    },
    {
      "id": "status.refresh",
      "label": "Refresh",
      "effect": "observe",
      "implementation": {
        "type": "presentation"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Draw this package's document again from the session state the host already holds",
      "confirmation_required": false
    }
