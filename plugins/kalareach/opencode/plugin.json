    {
      "capability": "metadata.match",
      "reason": "Recognise OpenCode from its published package and its executable name"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Show what the OpenCode session is doing and the controls for its turn"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read the turn, tool and permission events the bound server already publishes"
    },
    {
      "capability": "upstream.action",
      "reason": "Ask OpenCode to stop the turn it is running when you press Stop"
    }
  ],
  "actions": [
    {
      "id": "turn.cancel",
      "label": "Stop the turn",
      "effect": "upstream.cancel",
      "implementation": {
        "type": "upstream_cancel"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Cancel the turn the bound OpenCode execution is running, which ends it as interrupted",
      "confirmation_required": false
    },
    {
