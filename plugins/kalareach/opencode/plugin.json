    {
      "capability": "presentation.declarative",
      "reason": "Show what the OpenCode session is doing and the controls for its turn"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read the turn, tool and permission events the bound server already publishes"
    },
    {
      "capability": "upstream.action",
