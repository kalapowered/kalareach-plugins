{
  "manifest_version": 1,
  "publisher_id": "kalareach",
  "plugin_name": "codex",
  "version": "0.2.0",
  "display_name": "Codex CLI",
  "description": "Recognises Codex CLI, reads its App Server through a declarative table and stops the turn it is running.",
  "sdk_range": ">=0.1.0, <0.2.0",
  "wit_range": ">=0.1.0, <0.2.0",
