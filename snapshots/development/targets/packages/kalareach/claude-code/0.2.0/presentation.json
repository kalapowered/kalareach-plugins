{
  "manifest_version": 1,
  "base_revision": "1",
  "nodes": [
    {
      "id": "overview",
      "revision": "1",
      "body": {
        "kind": "markdown",
        "source": "Claude Code keeps its own terminal. Lifecycle and tool hooks report what it is doing, and the Channels surface carries messages in and the answer to a tool approval back. The answer appears beside the approval the host is holding, because that is what names the request. Project trust and MCP consent are answered in the terminal, where Claude Code asks for them."
      }
    },
    {
      "id": "activity",
      "revision": "1",
      "body": {
        "kind": "progress",
        "label": "Waiting for Claude Code",
        "state": {
          "kind": "indeterminate"
        }
      }
    },
    {
      "id": "compose",
      "revision": "1",
      "body": {
        "kind": "form",
        "title": "Message",
        "fields": {
          "parameters": [
            {
              "name": "text",
              "kind": {
                "type": "text",
                "max_length": 8000,
                "multiline": true
              },
              "label": "Message",
              "required": true
            }
          ]
        },
        "submit": {
          "id": "send",
          "revision": "1",
          "label": "Send",
          "icon": "send",
          "accessible_description": "Deliver this message into the Claude Code session",
          "action_id": "prompt.send",
          "parameters": {
            "parameters": [
              {
                "name": "text",
                "kind": {
                  "type": "text",
                  "max_length": 8000,
                  "multiline": true
                },
                "label": "Message",
                "required": true
              }
            ]
          },
          "priority": "primary",
          "visible_when": {
            "op": "all",
            "terms": [
              {
                "op": "grant",
                "right": "agent.prompt"
              },
              {
                "op": "not",
                "term": {
                  "op": "binding",
                  "state": "disabled"
                }
              }
            ]
          },
          "enabled_when": {
            "op": "all",
            "terms": [
              {
                "op": "not",
                "term": {
                  "op": "binding",
                  "state": "native_only_volatile"
                }
              },
              {
                "op": "capability",
                "capability": "upstream.action",
                "state": "qualified_available"
              }
            ]
          },
          "disabled_reason": "The channel is not carrying messages to this session"
        }
      }
    },
    {
      "id": "controls",
      "revision": "1",
      "body": {
        "kind": "action_group",
        "label": "Session",
        "controls": [
          {
            "id": "refresh",
            "revision": "1",
            "label": "Refresh",
            "icon": "retry",
            "accessible_description": "Draw the session's current state again from what this host already holds",
            "action_id": "status.refresh",
            "parameters": {
              "parameters": []
            },
            "priority": "secondary",
            "visible_when": {
              "op": "not",
              "term": {
                "op": "binding",
                "state": "disabled"
              }
            },
            "enabled_when": {
              "op": "not",
              "term": {
                "op": "flag",
                "flag": "transfer_in_progress"
              }
            },
            "disabled_reason": "An upload is in progress"
          }
        ]
      }
    }
  ],
  "voice": {
    "status_nodes": [
      "activity"
    ],
    "choice_controls": [
      "send"
    ],
    "detail_nodes": [
      "overview"
    ]
  }
}
