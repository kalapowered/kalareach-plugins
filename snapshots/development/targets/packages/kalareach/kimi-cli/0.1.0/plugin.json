  "capabilities": [
    {
      "capability": "metadata.match",
      "reason": "Recognise MoonshotAI's kimi-cli from its published package, and its executable names as a guess"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Show what the Kimi CLI session is doing and the controls for its turn"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read the turn and tool updates the selected agent-protocol execution reports"
    },
    {
      "capability": "upstream.action",
      "reason": "Ask Kimi CLI to stop the turn it is running when you press Stop"
    }
  ],
  "actions": [
    {
      "id": "turn.cancel",
      "label": "Stop the turn",
      "effect": "upstream.cancel",
      "implementation": {
        "type": "upstream_cancel"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Cancel the turn the bound Kimi CLI execution is running, which ends it as interrupted",
      "confirmation_required": false
    },
    {
      "id": "session.refresh",
      "label": "Refresh",
      "effect": "observe",
      "implementation": {
        "type": "presentation"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Draw this package's document again from the session state the host already holds",
